{
  "$comment": "claude-session-logger user-level hooks. Merge into ~/.claude/settings.json with: jq -s '.[0].hooks * .[1].hooks | {hooks: .}' ~/.claude/settings.json settings-snippet.json > /tmp/settings.json && mv /tmp/settings.json ~/.claude/settings.json (review the diff first). Replace $REPO with the checkout path. The logger prints nothing and exits 0, so it never disturbs sessions.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "export PATH=\"$HOME/.local/share/mise/shims:$HOME/.mise/shims:/opt/homebrew/bin:/usr/local/bin:$PATH\" && node \"$REPO/claude-plugins/claude-session-logger/lib/run-hook.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
