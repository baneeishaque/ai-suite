{
  "$comment": "copilot-session-logger user-level hooks (copy into ~/.copilot/hooks/, e.g. as session-logger.json). Replace <ABSOLUTE_PATH> with the real checkout path. GUI-spawned VS Code has no node on PATH, so each command prepends the mise/homebrew bin dirs first.",
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "export PATH=\"$HOME/.local/share/mise/shims:$HOME/.mise/shims:/opt/homebrew/bin:/usr/local/bin:$PATH\" && node <ABSOLUTE_PATH>/copilot-plugins/copilot-session-logger/lib/run-hook.js",
        "timeout": 30
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "export PATH=\"$HOME/.local/share/mise/shims:$HOME/.mise/shims:/opt/homebrew/bin:/usr/local/bin:$PATH\" && node <ABSOLUTE_PATH>/copilot-plugins/copilot-session-logger/lib/run-hook.js",
        "timeout": 30
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "export PATH=\"$HOME/.local/share/mise/shims:$HOME/.mise/shims:/opt/homebrew/bin:/usr/local/bin:$PATH\" && node <ABSOLUTE_PATH>/copilot-plugins/copilot-session-logger/lib/run-hook.js",
        "timeout": 30
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "export PATH=\"$HOME/.local/share/mise/shims:$HOME/.mise/shims:/opt/homebrew/bin:/usr/local/bin:$PATH\" && node <ABSOLUTE_PATH>/copilot-plugins/copilot-session-logger/lib/run-hook.js",
        "timeout": 30
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "command": "export PATH=\"$HOME/.local/share/mise/shims:$HOME/.mise/shims:/opt/homebrew/bin:/usr/local/bin:$PATH\" && node <ABSOLUTE_PATH>/copilot-plugins/copilot-session-logger/lib/run-hook.js",
        "timeout": 30
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "command": "export PATH=\"$HOME/.local/share/mise/shims:$HOME/.mise/shims:/opt/homebrew/bin:/usr/local/bin:$PATH\" && node <ABSOLUTE_PATH>/copilot-plugins/copilot-session-logger/lib/run-hook.js",
        "timeout": 30
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": "export PATH=\"$HOME/.local/share/mise/shims:$HOME/.mise/shims:/opt/homebrew/bin:/usr/local/bin:$PATH\" && node <ABSOLUTE_PATH>/copilot-plugins/copilot-session-logger/lib/run-hook.js",
        "timeout": 30
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "export PATH=\"$HOME/.local/share/mise/shims:$HOME/.mise/shims:/opt/homebrew/bin:/usr/local/bin:$PATH\" && node <ABSOLUTE_PATH>/copilot-plugins/copilot-session-logger/lib/run-hook.js",
        "timeout": 30
      }
    ]
  }
}
