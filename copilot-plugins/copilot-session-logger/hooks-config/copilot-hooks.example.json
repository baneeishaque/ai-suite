{
  "$comment": "copilot-session-logger user-level hooks. Global install: ln -s this file ~/.copilot/hooks/copilot-session-logger.json (assumes the checkout lives at ~/lab-data/ai-suite). GUI-spawned VS Code has no node on PATH, so each command prepends the mise/homebrew bin dirs first.",
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "export PATH=\"$HOME/.local/share/mise/shims:$HOME/.mise/shims:/opt/homebrew/bin:/usr/local/bin:$PATH\" && node \"$HOME/lab-data/ai-suite/copilot-plugins/copilot-session-logger/lib/run-hook.js\"",
        "timeout": 30
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "export PATH=\"$HOME/.local/share/mise/shims:$HOME/.mise/shims:/opt/homebrew/bin:/usr/local/bin:$PATH\" && node \"$HOME/lab-data/ai-suite/copilot-plugins/copilot-session-logger/lib/run-hook.js\"",
        "timeout": 30
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "export PATH=\"$HOME/.local/share/mise/shims:$HOME/.mise/shims:/opt/homebrew/bin:/usr/local/bin:$PATH\" && node \"$HOME/lab-data/ai-suite/copilot-plugins/copilot-session-logger/lib/run-hook.js\"",
        "timeout": 30
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "export PATH=\"$HOME/.local/share/mise/shims:$HOME/.mise/shims:/opt/homebrew/bin:/usr/local/bin:$PATH\" && node \"$HOME/lab-data/ai-suite/copilot-plugins/copilot-session-logger/lib/run-hook.js\"",
        "timeout": 30
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "command": "export PATH=\"$HOME/.local/share/mise/shims:$HOME/.mise/shims:/opt/homebrew/bin:/usr/local/bin:$PATH\" && node \"$HOME/lab-data/ai-suite/copilot-plugins/copilot-session-logger/lib/run-hook.js\"",
        "timeout": 30
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "command": "export PATH=\"$HOME/.local/share/mise/shims:$HOME/.mise/shims:/opt/homebrew/bin:/usr/local/bin:$PATH\" && node \"$HOME/lab-data/ai-suite/copilot-plugins/copilot-session-logger/lib/run-hook.js\"",
        "timeout": 30
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": "export PATH=\"$HOME/.local/share/mise/shims:$HOME/.mise/shims:/opt/homebrew/bin:/usr/local/bin:$PATH\" && node \"$HOME/lab-data/ai-suite/copilot-plugins/copilot-session-logger/lib/run-hook.js\"",
        "timeout": 30
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "export PATH=\"$HOME/.local/share/mise/shims:$HOME/.mise/shims:/opt/homebrew/bin:/usr/local/bin:$PATH\" && node \"$HOME/lab-data/ai-suite/copilot-plugins/copilot-session-logger/lib/run-hook.js\"",
        "timeout": 30
      }
    ]
  }
}
