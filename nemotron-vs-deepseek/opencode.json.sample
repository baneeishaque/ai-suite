{
  "$schema": "https://opencode.ai/config.json",
  "model": "nvidia/deepseek-v4-pro",
  "provider": {
    "nvidia": {
      "name": "NVIDIA build.nvidia.com",
      "options": {
        "apiKey": "${NVIDIA_API_KEY}",
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "timeout": 120000,
        "chunkTimeout": 30000
      }
    }
  }
}
