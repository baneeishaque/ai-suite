    "test:hook": "bun test --parallel=1 tests/layer1-hook",
    "test:recovery": "bun test --parallel=1 tests/layer2-recovery",
    "test:e2e": "E2E_RUN=1 bun test --parallel=1 tests/layer3-e2e",
