{
  "version": 2,
  "updates": [
    {
      "package-ecosystem": "gradle",
      "directory": "/",
      "schedule": {
        "interval": "daily",
        "time": "05:00",
        "timezone": "UTC"
      },
      "open-pull-requests-limit": 50,
      "cooldown": {
        "default-days": 3,
        "semver-major-days": 7,
        "semver-minor-days": 3,
        "semver-patch-days": 3
      },
      "commit-message": {
        "prefix": "chore",
        "include": "scope"
      },
      "assignees": [
        "baneeishaque"
      ],
      "reviewers": [
        "baneeishaque"
      ],
      "groups": {
        "major-updates": {
          "applies-to": "version-updates",
          "update-types": [
            "major"
          ],
          "patterns": [
            "*"
          ]
        },
        "minor-patch-updates": {
          "applies-to": "version-updates",
          "update-types": [
            "minor",
            "patch"
          ],
          "patterns": [
            "*"
          ]
        },
        "security-updates": {
          "applies-to": "security-updates",
          "patterns": [
            "*"
          ]
        }
      }
    },
